{
  "Lua.runtime.version": "Lua 5.4",
  "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.library": [
    "${workspaceFolder}"
  ],
  "Lua.diagnostics.globals": [
    "Citizen",
    "CreateThread",
    "Wait",
    "SetTimeout",
    "RegisterNetEvent",
    "AddEventHandler",
    "TriggerEvent",
    "TriggerClientEvent",
    "TriggerServerEvent",
    "RegisterCommand",
    "RegisterNUICallback",
    "SendNUIMessage",
    "GetCurrentResourceName",
    "GetInvokingResource",
    "GetHashKey",
    "PlayerPedId",
    "GetPlayerPed",
    "vector2",
    "vector3",
    "vector4",
    "quat",
    "exports",
    "GlobalState",
    "LocalPlayer",
    "Entity",
    "Player",
    "source"
  ],
  "Lua.diagnostics.disable": [
    "lowercase-global",
    "duplicate-set-field"
  ],
  "Lua.telemetry.enable": false,
  "editor.formatOnSave": false,
  "files.exclude": {
    "**/.git": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  }
}
